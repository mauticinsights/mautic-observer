# Monorepo PHPStan (composer phpstan → ../../bin/phpstan).
# Uses real Mautic classes from the root vendor; do not bootstrap Tests/Stubs.
# Standalone stub-based analysis: phpstan.standalone.neon.dist

parameters:
    level: 6
    tmpDir: .phpstan-cache
    reportUnmatchedIgnoredErrors: false
    treatPhpDocTypesAsCertain: false

    bootstrapFiles:
        - phpstan-bootstrap.php

    paths:
        - .

    excludePaths:
        - vendor/*
        - node_modules/*
        - .phpstan-cache/*
        # Stub doubles for standalone PHPUnit — not real Mautic APIs.
        - Tests/Stubs/*
        - phpstan/*
        # Tests target stub entities (stubId, etc.); analysed under standalone neon if needed.
        - Tests/*
        # CI (mautic-ci-runner) may copy this neon to the Mautic root.
        - plugins/MauticInsightsBundle/Tests/*
        - plugins/MauticInsightsBundle/Tests/Stubs/*
        - plugins/MauticInsightsBundle/phpstan/*
        - plugins/MauticInsightsBundle/vendor/*

    dynamicConstantNames:
        - MAUTIC_ENV
        - MAUTIC_TABLE_PREFIX
        - MAUTIC_VERSION

    ignoreErrors:
        # Same as Mautic root phpstan.neon — Symfony Form AbstractType generics.
        - identifier: missingType.generics
        # Cross-version runtime guards (method_exists / is_array) still useful on older Mautic lines.
        - identifier: function.alreadyNarrowedType
        - identifier: notIdentical.alwaysTrue
        - identifier: instanceof.alwaysTrue
        # table_prefix is Mautic-specific; DBAL getParams() PHPDoc omits it.
        -
            identifier: notIdentical.alwaysFalse
            path: Buffer/DatabaseEventBuffer.php
        -
            identifier: notIdentical.alwaysFalse
            path: plugins/MauticInsightsBundle/Buffer/DatabaseEventBuffer.php
        # Legacy class aliases for moved Buffer\* types; class_exists(..., false) is intentional.
        -
            identifier: function.impossibleType
            path: MauticInsightsBundle.php
        -
            identifier: function.impossibleType
            path: plugins/MauticInsightsBundle/MauticInsightsBundle.php
        # BC alias kept for older integrations reading SEGMENT_NOTIFY_URL.
        -
            identifier: classConstant.deprecated
            path: Integration/MauticInsightsIntegration.php
        -
            identifier: classConstant.deprecated
            path: plugins/MauticInsightsBundle/Integration/MauticInsightsIntegration.php
        # Must mirror core EncryptionHelper (untyped params).
        -
            identifier: missingType.parameter
            path: Service/SafeEncryptionHelper.php
        -
            identifier: missingType.parameter
            path: plugins/MauticInsightsBundle/Service/SafeEncryptionHelper.php
