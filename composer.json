{
    "name": "mauticinsights/mautic-observer",
    "description": "Observes Mautic contact, email, campaign, form, page and segment events and streams them to the Mautic Insights ingest API.",
    "version": "7.0.1",
    "type": "mautic-plugin",
    "license": "proprietary",
    "keywords": [
        "mautic",
        "plugin"
    ],
    "extra": {
        "install-directory-name": "MauticInsightsBundle"
    },
    "require": {
        "php": ">=8.2"
    },
    "suggest": {
        "mautic/core-lib": "Mautic 7.x core (^7.0) — required in production; not installed in this repo for standalone dev tooling.",
        "ext-redis": "Optional: Redis fallback for the API event buffer when the filesystem cache directory is not writable."
    },
    "require-dev": {
        "dg/bypass-finals": "^1.9",
        "doctrine/dbal": "^3.8",
        "doctrine/orm": "^2.14",
        "friendsofphp/php-cs-fixer": "^3.59",
        "phpstan/phpstan": "^1.12",
        "phpunit/phpunit": "^9.6",
        "symfony/config": "^6.4",
        "symfony/console": "^6.4",
        "symfony/dependency-injection": "^6.4",
        "symfony/http-client": "^6.4",
        "symfony/http-kernel": "^6.4",
        "symfony/translation-contracts": "^3.0",
        "symfony/validator": "^6.4"
    },
    "autoload": {
        "psr-4": {
            "MauticPlugin\\MauticInsightsBundle\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MauticPlugin\\MauticInsightsBundle\\Tests\\": "Tests/",
            "Mautic\\": "Tests/Stubs/Mautic/"
        }
    },
    "scripts": {
        "cs-fixer": "../../bin/php-cs-fixer fix --config .php-cs-fixer.php --show-progress dots -v",
        "phpstan": "../../bin/phpstan analyse . --memory-limit=1G -c phpstan.neon.dist",
        "test": "../../bin/phpunit -d memory_limit=2048M --configuration phpunit.xml.dist --fail-on-warning",
        "all": [
            "@cs-fixer",
            "@phpstan",
            "@test"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "platform": {
            "php": "8.2.0"
        },
        "sort-packages": true
    }
}
